多态
class AC:                        父类创建一个强制标准
    def cool():                
        pass
class Midea(AC)                    子类具体写各自方法
    def cool(self):
        print(美的制冷)
class Gree(AC):
    def cool(self):
        print(格力制冷)

def cool_air(ac:AC)
    ac.cool()                        让传入的空调实行自己的制冷方法
cool_air(Midea())                #美的制冷
cool_air(Gree())                #格力制冷






