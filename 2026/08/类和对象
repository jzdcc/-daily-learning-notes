            魔术方法
class Student:
    def__init__(self,name,age):
        self.name=name
        self.age=age    
__init__

    def __str__(self):
        return(f"我的名字是{self.name} 年龄{self.age}")        不能写print 因为函数外有print要接收函数传出的数据而不是直接输出 
__str__

    def__lt__(self,other):
        return self.age<other.age
__lt__            不能乱自定义 运算符和魔术方法一一对应
__le__
__eq__
